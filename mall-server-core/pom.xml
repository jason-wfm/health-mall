	<profiles>
		<!-- [healthmall-ext] 原 core jar 对照通道：仅用于 A/B 行为验证，需先将
		     src/main/java/com/wechuang/mallshop/core 移出编译路径（同名类冲突），用后必须还原 -->
		<profile>
			<id>core-legacy</id>
			<dependencies>
				<dependency>
					<groupId>com.wechuang.mallshop</groupId>
					<artifactId>core</artifactId>
					<version>3.0.27908</version>
					<scope>system</scope>
					<systemPath>${project.basedir}/reference/core-3.0.27908.jar</systemPath>
				</dependency>
			</dependencies>
		</profile>
		<!--开发环境 -->
		<profile>
			<id>local</id>
			<properties>
				<profiles.active>local</profiles.active>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
		</profile>
		<profile>
			<id>dev</id>
			<properties>
				<profiles.active>dev</profiles.active>
			</properties>
			<activation>
				<activeByDefault>false</activeByDefault>
			</activation>
		</profile>
		<!--生产环境 -->
		<profile>
			<id>prod</id>
			<properties>
				<skipTests>true</skipTests>
				<profiles.active>prod</profiles.active>
			</properties>
		</profile>
	</profiles>
	<build>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*Mapper.xml</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**</include>
				</includes>
				<!--开启过滤，用指定的参数替换directory下的文件中的参数-->
				<filtering>true</filtering>
			</resource>
			<resource>
				<directory>${project.basedir}/lib</directory>
				<targetPath>BOOT-INF/lib/</targetPath>
				<includes>
					<include>**/*.jar</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<!-- 添加 maven-compiler-plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<encoding>UTF-8</encoding>
					<compilerArgs>
						<arg>-parameters</arg>
					</compilerArgs>
					<showWarnings>true</showWarnings>
					<verbose>false</verbose>
					<fork>true</fork>
				</configuration>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<nonFilteredFileExtensions>
						<nonFilteredFileExtension>ttf</nonFilteredFileExtension>
						<nonFilteredFileExtension>woff</nonFilteredFileExtension>
						<nonFilteredFileExtension>woff2</nonFilteredFileExtension>
					</nonFilteredFileExtensions>
				</configuration>
			</plugin>
			<!-- [healthmall-ext] 恢复测试执行（基线无测试类，恢复不影响存量构建） -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
				</configuration>
			</plugin>
			<!-- Docker -->
			<plugin>
				<groupId>com.spotify</groupId>
				<artifactId>docker-maven-plugin</artifactId>
				<version>${docker.maven.plugin.version}</version>
				<!-- [healthmall-ext] 移除 package 阶段自动构建/推送远程镜像，改为手动执行 mvn docker:build -->
				<configuration>
					<!--定义镜像名称-->
					<imageName>modulithshop/${project.artifactId}:${project.version}</imageName>
					<!-- Docker 远程管理地址-->
					<dockerHost>${docker.host}</dockerHost>
					<!--定义基础镜像-->
					<baseImage>eclipse-temurin:17-jre</baseImage>
					<!--定义容器启动命令-->
					<entryPoint>["java","-Xms256m", "-Xmx2048m", "-XX:MetaspaceSize=128M", "-XX:MaxMetaspaceSize=2048M", "-Dspring.profiles.active=prod",  "-jar", "-Duser.timezone=Asia/Shanghai", "/${project.build.finalName}.jar"]</entryPoint>
					<!--推送镜像仓库校验安全证书，无安全证书无法推送-->
					<dockerCertPath>E:\docker-ca</dockerCertPath>
					<resources>
						<resource>
							<targetPath>/</targetPath>
							<directory>${project.build.directory}</directory>
							<include>${project.build.finalName}.jar</include>
						</resource>
					</resources>
				</configuration>
			</plugin>
			<!-- Docker end-->
		</plugins>
	</build>
